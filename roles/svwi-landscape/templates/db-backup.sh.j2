#!/bin/bash
# PostgreSQL database backup script for Landscape
# Intended to be run as the postgres user

# Change to a safe directory to avoid permission issues
cd /tmp

# Set environment variables
export VAULT_ADDR="{{ vault_addr }}"
# No need to export PGPASSWORD since we run as postgres user

# Create a timestamp for the backup file
TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
BACKUP_DIR="{{ backup_dir }}"
BACKUP_FILE="${BACKUP_DIR}/pg_all_dbs_${TIMESTAMP}.sql.gz"
GCP_BUCKET="{{ gcp_bucket }}"

# Ensure backup directory exists
mkdir -p ${BACKUP_DIR}

# Ensure log file exists
LOG_FILE="{{ log_file }}"
touch ${LOG_FILE}

# Log function
log() {
  echo "$(date): $1" | tee -a ${LOG_FILE}
}

log "Starting PostgreSQL backup"

# Perform database dump of all databases and compress it
log "Dumping all databases..."
pg_dumpall | gzip > ${BACKUP_FILE}

if [ $? -eq 0 ]; then
  log "Database dump completed successfully."
  log "Backup saved at: ${BACKUP_FILE}"
  ls -lh ${BACKUP_FILE} | tee -a ${LOG_FILE}

  # Check if we have access to a vault token for GCP
  if [ -f "/run/vault-postgres/landscape.token" ]; then
    log "Found Vault token, attempting to upload to GCP bucket..."

    # Read vault token (from AppRole agent) and get GCP token
    VAULT_TOKEN=$(cat /run/vault-postgres/landscape.token)
    GCP_TOKEN=$(curl -s --header "X-Vault-Token: ${VAULT_TOKEN}" ${VAULT_ADDR}/v1/gcp/static-account/landscape-backup/token | jq -r .data.token)

    if [ -n "${GCP_TOKEN}" ] && [ "${GCP_TOKEN}" != "null" ]; then
      log "Retrieved GCP token, uploading to bucket..."

      # Upload to GCP
      curl -s -X POST --data-binary @${BACKUP_FILE} \
        -H "Authorization: Bearer ${GCP_TOKEN}" \
        -H "Content-Type: application/octet-stream" \
        "https://storage.googleapis.com/upload/storage/v1/b/${GCP_BUCKET}/o?name=pg_all_dbs_${TIMESTAMP}.sql.gz&uploadType=media" > /tmp/gcp_upload_result.json

      if grep -q "kind" /tmp/gcp_upload_result.json; then
        log "Successfully uploaded backup to GCP bucket ${GCP_BUCKET}"

        # After successful upload, keep local backups for just 7 days
        find ${BACKUP_DIR} -name "pg_all_dbs_*.sql.gz" -type f -mtime +7 -delete
        log "Cleaned up old local backups (keeping 7 days of history)."
      else
        log "Error uploading to GCP: $(cat /tmp/gcp_upload_result.json)"
        log "Keeping local backups for longer since upload failed."
      fi
    else
      log "Could not retrieve GCP token from Vault, skipping upload."
    fi
  else
    log "No Vault token found at /run/vault-postgres/landscape.token, skipping GCP upload."

    # Keep backups for longer (30 days) if we can not upload to GCP
    find ${BACKUP_DIR} -name "pg_all_dbs_*.sql.gz" -type f -mtime +30 -delete
    log "Cleaned up old local backups (keeping 30 days of history)."
  fi
else
  log "Error: Database dump failed."
fi

log "Backup process completed"

